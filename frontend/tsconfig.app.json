{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Modo estrito */
    "strict": true,
    // noUncheckedIndexedAccess fica de fora: os CSS Modules do Vite são
    // tipados por assinatura de índice, então toda classe viraria
    // `string | undefined` e o código encheria de `?? ''`. Onde o índice
    // pode mesmo faltar — arrays e o mapa de campos inválidos do servidor —
    // o `undefined` é declarado no próprio tipo.
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  // Os testes rodam no Node, com outro conjunto de tipos: ficam em
  // tsconfig.test.json.
  "exclude": ["src/**/*.test.ts"]
}
